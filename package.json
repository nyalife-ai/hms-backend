{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "Calvince Owino Ochieng <t313jalikoa@gmail.com>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.framework.json",
    "build:app": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node scripts/ensure-prisma-dist.cjs && node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --ignore-pattern \"src/modules/**\"",
    "test:core": "jest --config src/core/jest.config.js --coverage",
    "test:core:watch": "jest --config src/core/jest.config.js --watch",
    "test:platform": "jest --config src/platform/jest.config.js --coverage",
    "test:platform:watch": "jest --config src/platform/jest.config.js --watch",
    "test:infrastructure": "jest --config src/infrastructure/jest.config.js --coverage",
    "test:infrastructure:watch": "jest --config src/infrastructure/jest.config.js --watch",
    "test:shared": "jest --config src/shared/jest.config.js --coverage",
    "test:shared:watch": "jest --config src/shared/jest.config.js --watch",
    "test:modules": "jest --coverage=false --testPathPatterns=modules/",
    "test": "yarn test:core && yarn test:platform && yarn test:infrastructure && yarn test:shared && yarn test:modules",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:smoke": "jest --config ./test/jest-e2e.json test/smoke.e2e-spec.ts --runInBand",
    "test:regression": "jest --config ./test/jest-e2e.json test/regression.e2e-spec.ts --runInBand",
    "test:integration": "jest --config ./test/jest-e2e.json --testPathPatterns=integration",
    "test:security": "jest --testPathPatterns=security",
    "test:perf": "echo 'Run k6 load test: k6 run test/load-test.k6.js'",
    "test:load": "k6 run test/load-test.k6.js",
    "test:all": "yarn test && yarn test:e2e",
    "module:generate": "bash src/modules/module.sh",
    "postinstall": "node scripts/patch-brace-expansion.cjs && prisma generate",
    "migration:run": "typeorm migration:run -d src/data-source.ts",
    "migration:revert": "typeorm migration:revert -d src/data-source.ts",
    "migration:generate": "typeorm migration:generate -d src/data-source.ts src/migrations/NewMigration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "prisma:schema:from-sql": "node scripts/sql-to-prisma.mjs",
    "db:setup": "prisma migrate deploy && npm run prisma:seed"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^5.0.0",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "bullmq": "^6.0.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "crypto-js": "^4.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "firebase-admin": "^13.7.0",
    "handlebars": "^4.7.9",
    "ioredis": "^5.10.0",
    "jest-junit": "^16.0.0",
    "marked": "^18.0.7",
    "mysql2": "^3.19.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-elasticsearch": "^0.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^11.0.0",
    "brace-expansion": "^5.0.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "js-yaml": "^5.2.2",
    "prettier": "^3.4.2",
    "prisma": "5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "resolutions": {
    "**/brace-expansion": "5.0.8",
    "**/js-yaml": "5.2.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(uuid)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "maxWorkers": 4,
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
