# ============================================================================
# APP CONFIGURATION
# ============================================================================
NODE_ENV=development
# Use 4000 so the Next.js frontend can stay on 3000
PORT=4000
PUBLIC_URL=http://localhost:4000
APP_NAME=nyalife-api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080

# ============================================================================
# INSURANCE SWITCH (single Nest gateway — UI never calls insurers directly)
# ============================================================================
# Architecture:
#   Frontend  →  POST /insurance/*  →  Nest InsuranceService  →  adapter
#     SHA     = Social Health Authority (gov)      → SHA_* credentials
#     SLADE   = private insurers (Jubilee/AAR/…)   → Slade360 HealthCloud
#     MANUAL  = offline insurers (Madison/…)       → no remote call
#
# Providers are loaded from DB via GET /insurance/providers (one list for the UI).
# Leave Slade/SHA keys empty → sandbox simulation. Fill keys → live traffic.
#
# --- SHA (government) ---
# SHA_BASE_URL=
# SHA_API_KEY=
# SHA_PROVIDER_CODE=
#
# --- Slade360 HealthCloud (OAuth2 client_id + client_secret) ---
# Chronological flow: eligibility → OTP → start_visit → reserve/claim
# SLADE_CLIENT_ID=
# SLADE_CLIENT_SECRET=          # or SLADE_SECRET_KEY=
# SLADE_TOKEN_URL=https://provider-edi-api.multitenant.slade360.co.ke/o/token/
# SLADE_EDI_BASE_URL=https://provider-edi-api.multitenant.slade360.co.ke
# SLADE_IS_BASE_URL=https://is-api.multitenant.slade360.co.ke
# Payer codes on the EDI network (comma-separated CODE:slade_code)
# SLADE_PAYER_CODES=JUBILEE:457
# SLADE_LOCATION_CODE=T01
# SLADE_LOCATION_NAME=NyaLife Clinic
# Demo: auto-accept after N ms (0/unset = real payer only)
# SLADE_DEMO_AUTO_ACCEPT_MS=15000
# SLADE_ELIGIBILITY_MEMBER_PARAM=member_number
# SLADE_ELIGIBILITY_PAYER_PARAM=payer

# ============================================================================
# SAFARICOM DARAJAR M-PESA (STK Push checkout)
# ============================================================================
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://your-public-api/billing/mpesa/callback
# MPESA_CALLBACK_SECRET=
# MPESA_CALLBACK_ALLOWED_IPS=   # optional extras; defaults include Daraja ranges
# MPESA_DEMO_AUTO_CONFIRM_MS=20000
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ============================================================================
# AFRICA'S TALKING SMS (notifications module)
# Dashboard: https://account.africastalking.com → Settings → API Key
# Sandbox username is usually "sandbox"; production uses your app username.
# ============================================================================
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_FROM=          # sender ID / short code (optional in sandbox)
# AFRICASTALKING_ENV=sandbox    # sandbox | production


# ============================================================================
# ORM SELECTION
# Choose ONE provider per deployment: 'prisma' or 'typeorm'
# ============================================================================
ORM_PROVIDER=prisma
# true = API boots even if Supabase is unreachable (auth falls back to in-memory)
# false = require a live DATABASE_URL (recommended once Supabase is configured)
DATABASE_OPTIONAL=true

# ============================================================================
# SUPABASE + PRISMA (NestJS long-lived process)
# Project Settings → Database → Connection string
#
# DATABASE_URL  → Session-mode pooler (port 5432 on *.pooler.supabase.com)
#                 Keep connection_limit LOW (≤3). Supabase session pools are
#                 often capped near pool_size=15 TOTAL many Nest dynos × high
#                 Prisma limits → FATAL EMAXCONNSESSION on live billing.
# DIRECT_URL    → Same session URL, or db.PROJECT_REF.supabase.co:5432 for migrate
#
# Render / production checklist:
#   DATABASE_URL=...pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=3&pool_timeout=30
#   Prefer 1 web dyno (or raise Supabase pool size) if you scale horizontally.
#
# Avoid Transaction pooler (6543) for Nest unless you must — if you use it, set:
#   ?pgbouncer=true&connection_limit=1&pool_timeout=20
#
# After filling these in:
#   npm run prisma:generate
#   npm run db:setup          # migrate deploy + seed
# ============================================================================
# DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=3&pool_timeout=30"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Alternative direct host:
# DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Local Postgres fallback (unused when Supabase URLs above are set)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_db_password
DATABASE_NAME=postgres
DATABASE_URL="postgresql://postgres:your_secure_db_password@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:your_secure_db_password@localhost:5432/postgres"

# ============================================================================
# REDIS CONFIGURATION (BullMQ Queues & Caching)
# Prefer REDIS_URL when set. Otherwise REDIS_HOST/REDIS_PORT/REDIS_PASSWORD are
# assembled into REDIS_URL by InfrastructureConfigService.
# ============================================================================
# REDIS_URL=redis://:password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Bull queue namespacing (avoid collisions on shared Redis — do NOT use bare "payments-queue")
BULL_PREFIX=nyalife
BULL_PAYMENTS_QUEUE=nyalife-payments
BULL_NOTIFICATIONS_QUEUE=nyalife-notifications

# ============================================================================
# AUTHENTICATION (JWT)
# Generate a strong secret: openssl rand -hex 64
# ============================================================================
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION=15m
JWT_REFRESH_DAYS=7
# Demo role-picker login (POST /auth/demo-login). Auto-off in production unless true.
ENABLE_DEMO_AUTH=true

# ============================================================================
# ENCRYPTION (AES-256-CBC)
# MUST be exactly 32 characters long for direct use, or it will be derived.
# Generate: openssl rand -hex 16
# ============================================================================
ENCRYPTION_SECRET_KEY=replace-with-exactly-32-characters

# ============================================================================
# EXTERNAL SERVICE INTEGRATIONS (Examples)
# Add one block per third-party API your service consumes. Prefix variables
# with the provider name for clarity, e.g. BILLING_API_KEY, SEARCH_API_URL.
# ============================================================================
EXTERNAL_SERVICE_API_KEY=your_external_service_api_key
EXTERNAL_SERVICE_API_SECRET=your_external_service_api_secret
EXTERNAL_SERVICE_BASE_URL=https://api.example.com
EXTERNAL_SERVICE_CALLBACK_URL=https://your-public-domain.com/webhooks/example

# ============================================================================
# NOTIFICATIONS (Email - SMTP)
# Used for password-reset OTP delivery. If SMTP_HOST is empty, OTP is logged
# to the API console in non-production (never emailed).
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# ============================================================================
# NOTIFICATIONS (Push - Optional)
# Configure your push provider credentials here (e.g., Firebase, OneSignal).
# ============================================================================
PUSH_PROVIDER_PROJECT_ID=your_project_id
PUSH_PROVIDER_CLIENT_EMAIL=service-account@your_project.example.com
PUSH_PROVIDER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================================================
# STORAGE (S3-compatible object storage)
# Used for user uploads, generated documents, and other binary assets.
#
# STORAGE_ENGINE is an alias for STORAGE_PROVIDER (STORAGE_PROVIDER wins if
# both are set). Supported engines: local | s3 | r2 | minio | supabase | azure | gcs
#
# local     — filesystem storage, only needs STORAGE_LOCAL_DIRECTORY + STORAGE_SIGNING_SECRET
# s3        — AWS S3; STORAGE_ENDPOINT optional, uses AWS_REGION/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# r2        — Cloudflare R2; STORAGE_ENDPOINT required (https://<account_id>.r2.cloudflarestorage.com)
# minio     — self-hosted S3-compatible; STORAGE_ENDPOINT optional
# supabase  — Supabase Storage S3 protocol; STORAGE_ENDPOINT required (project storage S3 endpoint)
# azure     — needs AZURE_STORAGE_CONNECTION_STRING + STORAGE_CONTAINER
# gcs       — needs STORAGE_BUCKET (uses Application Default Credentials)
# ============================================================================
STORAGE_ENGINE=s3
STORAGE_PROVIDER=s3
STORAGE_BUCKET=app-documents
STORAGE_ENDPOINT=https://your-storage-endpoint.example.com
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_SIGNING_SECRET=replace-with-a-long-random-secret
STORAGE_MAX_BYTES=10485760
STORAGE_ALLOWED_CONTENT_TYPES=image/*,application/pdf

# ============================================================================
# REALTIME COMMUNICATION PLATFORM
# Provider-based fan-out for future modules. Business code should inject
# RealtimeService only — never Socket.IO / Nest WS / SSE directly.
#
# REALTIME_PROVIDER: noop | nest-ws | socketio | sse | firebase | pusher | ably
# REALTIME_TRANSPORT: ws | socketio | sse | none
# REALTIME_AUTH: jwt | api-key | anonymous
# When REALTIME_ENABLED=false the platform always uses NoopRealtimeProvider.
# For live WebSocket delivery: REALTIME_ENABLED=true, REALTIME_PROVIDER=socketio, REALTIME_TRANSPORT=socketio, REALTIME_AUTH=jwt
# ============================================================================
REALTIME_ENABLED=false
REALTIME_PROVIDER=noop
REALTIME_TRANSPORT=none
REALTIME_PORT=3001
REALTIME_HEARTBEAT=30000
REALTIME_AUTH=jwt
# REALTIME_JWT_SECRET=  # falls back to JWT_SECRET when unset
# REALTIME_API_KEYS=key1,key2
# REALTIME_MAX_CONNECTIONS=10000
# REALTIME_MAX_ROOMS=10000
# REALTIME_MAX_CONNECTIONS_PER_ROOM=1000
# REALTIME_PRESENCE_ENABLED=true
# REALTIME_PRESENCE_IDLE_MS=90000

# ============================================================================
# OBSERVABILITY
# ============================================================================
LOG_LEVEL=debug
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000
METRICS_TOKEN=your_secure_metrics_scrape_token
SENTRY_DSN=

# ============================================================================
# OBSERVABILITY PLATFORM (enterprise)
# Master switch + per-feature switches. When OBSERVABILITY_ENABLED=false, or
# a feature-specific *_ENABLED flag is false, ObservabilityModule.forRoot()
# always falls back to a safe noop/in-memory implementation for that feature
# — the app keeps booting even with nothing configured.
#
# OBSERVABILITY_TRACER:         noop | memory | otel
# OBSERVABILITY_LOGGER:         json | pino | winston
# OBSERVABILITY_METRICS:        memory | prometheus | otel
# OBSERVABILITY_ERROR_REPORTER: memory | sentry | bugsnag | noop
# ============================================================================
OBSERVABILITY_ENABLED=true
TRACING_ENABLED=true
METRICS_ENABLED=true
LOGGING_ENABLED=true
ERROR_REPORTING_ENABLED=true
PROFILING_ENABLED=true
OBSERVABILITY_TRACER=memory
OBSERVABILITY_LOGGER=json
OBSERVABILITY_METRICS=memory
OBSERVABILITY_ERROR_REPORTER=memory

# ============================================================================
# OPENTELEMETRY
# All @opentelemetry/* packages are optional runtime drivers (see
# src/platform/observability/providers/opentelemetry). Set OTEL_ENABLED=true
# and OBSERVABILITY_TRACER=otel (and/or OBSERVABILITY_METRICS=otel) after
# installing @opentelemetry/api and the exporter package you need.
#
# OTEL_EXPORTER: otlp | jaeger | zipkin | tempo | prometheus | console | noop
# ============================================================================
OTEL_ENABLED=false
OTEL_EXPORTER=console
OTEL_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=nyalife-api
OTEL_SERVICE_VERSION=1.0.0
AUTO_INSTRUMENTATION=false

# ============================================================================
# SUPABASE STORAGE (S3-compatible) — optional; falls back to in-memory
# ============================================================================
# STORAGE_PROVIDER=supabase
# STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# STORAGE_BUCKET=documents
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=auto
# STORAGE_SIGNING_SECRET=change-me-in-production
# STORAGE_MAX_BYTES=10485760
# REALTIME_PROVIDER=socketio
# REDIS_OPTIONAL=true
