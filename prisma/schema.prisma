  rate_percentage Decimal @db.Decimal(5, 2)
  liability_account_id String @db.Uuid
  is_active Boolean @default(true)
  created_at DateTime @db.Timestamptz(6) @default(now())
  updated_at DateTime @db.Timestamptz(6) @updatedAt
  liability_account Accounts @relation(fields: [liability_account_id], references: [id], name: "TaxRates_Accounts_liability_account_id")
  @@map("tax_rates")
  @@schema("billing")
}

model Conversations {
