/// Daraja STK Push checkout sessions (pending → success/fail)
model MpesaTransactions {
  id                   String    @id @default(uuid()) @db.Uuid
  checkout_request_id  String    @unique @db.VarChar(100)
  merchant_request_id  String?   @db.VarChar(100)
  phone                String    @db.VarChar(20)
  amount               Decimal   @db.Decimal(15, 2)
  account_reference    String    @db.VarChar(50)
  description          String?   @db.VarChar(200)
  status               String    @default("PENDING") @db.VarChar(20)
  result_code          String?   @db.VarChar(20)
  result_desc          String?
  mpesa_receipt_number String?   @db.VarChar(50)
  visit_id             String?   @db.Uuid
  patient_id           String?   @db.Uuid
  source               String    @default("RECEPTION") @db.VarChar(30)
  initiated_by         String    @db.Uuid
  payload              Json      @default("{}")
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @updatedAt @db.Timestamptz(6)
  receipts             Receipts[]

  @@index([status])
  @@index([visit_id])
  @@map("mpesa_transactions")
  @@schema("billing")
}

/// Printable / stored facility receipts after successful checkout
model Receipts {
  id                    String    @id @default(uuid()) @db.Uuid
  receipt_number        String    @unique @db.VarChar(40)
  patient_id            String    @db.Uuid
  visit_id              String?   @db.Uuid
  invoice_id            String?   @db.Uuid
  payment_id            String?   @db.Uuid
  mpesa_transaction_id  String?   @db.Uuid
  channel               String    @db.VarChar(20)
  amount                Decimal   @db.Decimal(15, 2)
  issued_by             String    @db.Uuid
  issued_at             DateTime  @default(now()) @db.Timestamptz(6)
  line_items            Json      @default("[]")
  meta                  Json      @default("{}")
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  mpesa_transaction     MpesaTransactions? @relation(fields: [mpesa_transaction_id], references: [id], onDelete: SetNull)

  @@index([patient_id])
  @@index([visit_id])
  @@map("receipts")
  @@schema("billing")
}
