  encrypted_payload String
  created_at DateTime @db.Timestamptz(6) @default(now())
  edited_at DateTime? @db.Timestamptz(6)
  is_deleted Boolean @default(false)
  view_once_expires_at DateTime? @db.Timestamptz(6)
  conversation Conversations @relation(fields: [conversation_id], references: [id], name: "Messages_Conversations_conversation_id", onDelete: Cascade)
  sender User @relation(fields: [sender_id], references: [id], name: "Messages_User_sender_id")
  parent_message Messages? @relation(fields: [parent_message_id], references: [id], name: "Messages_Messages_parent_message_id", onDelete: SetNull)
  communications_messages_parent_message_id Messages[] @relation(name: "Messages_Messages_parent_message_id")
  communications_message_attachments_message_id MessageAttachments[] @relation(name: "MessageAttachments_Messages_message_id")
  communications_message_delivery_receipts_message_id MessageDeliveryReceipts[] @relation(name: "MessageDeliveryReceipts_Messages_message_id")
  communications_message_reactions_message_id MessageReactions[] @relation(name: "MessageReactions_Messages_message_id")
  communications_message_edit_history_message_id MessageEditHistory[] @relation(name: "MessageEditHistory_Messages_message_id")
  @@map("messages")
  @@schema("communications")
}

