# Isolated regression test env — copy to `.env.test` if missing.
# Loaded ONLY by Jest via test/setup/load-env-test.cjs.
# Never copy these values into application `.env`.

NODE_ENV=test
ORM_PROVIDER=prisma

DATABASE_URL=postgresql://hms_test:hms_test@127.0.0.1:5433/hms_test?connection_limit=5&pool_timeout=20&connect_timeout=10
DIRECT_URL=postgresql://hms_test:hms_test@127.0.0.1:5433/hms_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

BULL_PREFIX=nyalife-test
BULL_PAYMENTS_QUEUE=nyalife-test-payments
BULL_NOTIFICATIONS_QUEUE=nyalife-test-notifications

JWT_SECRET=nyalife-test-jwt-secret-do-not-use-in-prod-32
JWT_EXPIRATION=15m
JWT_REFRESH_DAYS=7
ENABLE_DEMO_AUTH=false
ENCRYPTION_SECRET_KEY=nyalife-test-encrypt-key-32ch!!

PUSH_PROVIDER_PROJECT_ID=
PUSH_PROVIDER_CLIENT_EMAIL=
PUSH_PROVIDER_PRIVATE_KEY=
