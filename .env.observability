################################################################################
# .env.observability
#
# PURPOSE:
# Environment variables specifically for the Observability Stack
# (Prometheus, Alertmanager, Grafana, Elasticsearch, Logstash, Kibana, Filebeat).
#
# USAGE:
# Pass this file to docker compose when starting the monitoring stack:
#   docker compose --env-file .env.observability -f docker-compose.yml -f docker-compose.observability.yml up -d
#
# SECURITY NOTE:
# GRAFANA_ADMIN_PASSWORD and KIBANA_ENCRYPTION_KEY are REQUIRED (compose will
# refuse to start without them). Change every default before deploying to
# staging or production.
################################################################################

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# Attached to log events by Logstash (development | staging | production)
# ============================================================================
ENVIRONMENT=development

# ============================================================================
# GRAFANA CONFIGURATION
# ============================================================================
GRAFANA_ADMIN_USER=admin
# REQUIRED. Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=change-me-before-first-start

# The public URL where Grafana will be accessed (used for alert links and UI)
GRAFANA_ROOT_URL=http://localhost:3100

# ============================================================================
# KIBANA & ELASTICSEARCH CONFIGURATION
# ============================================================================
# The public URL where Kibana will be accessed
KIBANA_PUBLIC_URL=http://localhost:5601

# REQUIRED. A random 32+ character string used to encrypt saved objects in
# Kibana. Generate: openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=change-this-to-a-random-32-character-string-now

# ============================================================================
# ELASTICSEARCH SECURITY (Optional)
# ============================================================================
# Note: docker-compose.observability.yml sets xpack.security.enabled=false
# for easier local development. If you enable it in production, uncomment and set:
# ELASTIC_PASSWORD=your-secure-elastic-password-here
# KIBANA_PASSWORD=your-secure-kibana-password-here
